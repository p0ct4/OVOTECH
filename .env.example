# =============================================================================
# OVOTECH - Variables de entorno
# =============================================================================
# Copiá este archivo a .env y completá los valores:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# El archivo .env NO se sube a Git (está en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Cadena de conexión PostgreSQL. En producción se usa Neon; en local podés
# usar la misma URL de Neon o un Postgres local.
#
# Ejemplo Neon:
# DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Servidor API (opcional)
# -----------------------------------------------------------------------------
# Puerto donde corre Uvicorn. Render inyecta PORT automáticamente.
PORT=8000

# -----------------------------------------------------------------------------
# MQTT (opcional — tienen valores por defecto en mqtt_client.py)
# -----------------------------------------------------------------------------
# Broker público por defecto: HiveMQ. Debe coincidir con el firmware ESP32
# y con simulador_esp32.py si no los modificás.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=ovotech/sensor
